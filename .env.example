# Copia este archivo a ".env" y completa los valores reales.
# Ninguna de estas claves va commiteada al repositorio (.env está en .gitignore).

# RPC de Polygon Amoy (testnet). El público funciona para el MVP, pero tiene
# límite de peticiones. Para más estabilidad, usar un proveedor free-tier
# como Alchemy o Infura y pegar aquí su URL de Amoy.
EXPO_PUBLIC_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# API key de RevenueCat para Android (dashboard de RevenueCat > Project
# Settings > API keys). Se necesita para que revenuecatService.ts funcione.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# (Opcional) API key de RevenueCat para iOS, si más adelante se agrega esa
# plataforma.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
