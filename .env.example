# Copia este archivo a ".env" y completa los valores reales.
# Ninguna de estas claves va commiteada al repositorio (.env está en .gitignore).

# RPC de Polygon Amoy (testnet). El de publicnode.com es gratuito y no
# requiere cuenta; el endpoint oficial de Polygon (rpc-amoy.polygon.technology)
# no resolvió por DNS en pruebas reales en dispositivo con algunas redes.
# Para más estabilidad a futuro, se puede cambiar por un proveedor con
# cuota propia (Alchemy o Infura free tier).
EXPO_PUBLIC_AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com

# API key de RevenueCat para Android (dashboard de RevenueCat > Project
# Settings > API keys). Se necesita para que revenuecatService.ts funcione.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# (Opcional) API key de RevenueCat para iOS, si más adelante se agrega esa
# plataforma.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# App ID de OneSignal (dashboard de OneSignal > Settings > Keys & IDs).
# Se usa para mandar recordatorios push a los testers de la prueba cerrada
# ("abrí Verity hoy") — Google exige testers activos a diario durante 14
# días seguidos, no solo la instalación inicial. Ver onesignalService.ts.
EXPO_PUBLIC_ONESIGNAL_APP_ID=

# Permite simular PRO desde Ajustes ("Modo prueba") fuera de Expo Go —
# pensada EXCLUSIVAMENTE para el build "preview" de EAS (ver
# documentation/technical/apk-build-plan.md). Configúrala SOLO en el
# entorno "preview" de EAS (`eas env:set`), nunca en "production" — así
# el build real que se suba a la tienda nunca tiene forma de activar
# PRO gratis. En local (Expo Go) no hace falta: ahí ya funciona solo
# por estar en modo desarrollo.
EXPO_PUBLIC_ALLOW_DEV_PRO_OVERRIDE=

# Índice público de certificados (proyecto Supabase "verity-mvp") — permite
# verificar un archivo sellado desde OTRO dispositivo por su hash, sin tener
# que escribir el número de sello a mano. Solo guarda metadatos ya visibles
# en la blockchain (nunca el archivo). Ver backend/README.md.
EXPO_PUBLIC_SUPABASE_URL=https://lxzmegutqorsmnoonkyv.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_vB96zak90W2LTS56ETj-SA_aHyEAEhY
